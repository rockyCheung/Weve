# 应用图标生成说明
# 需要准备一个 1024x1024 的 PNG 图标文件，命名为 icon.png
# 然后使用以下命令生成各平台所需格式：

# 生成 PNG 图标
convert icon.png -resize 32x32 icons/32x32.png
convert icon.png -resize 128x128 icons/128x128.png
convert icon.png -resize 256x256 icons/128x128@2x.png

# 生成 Windows ICO
convert icon.png -resize 256x256 icons/icon.ico

# 生成 macOS ICNS
convert icon.png -resize 512x512 icons/icon.icns

# 或者使用 Tauri 内置工具
# cargo tauri icon